# Токен нового бота из BotFather — отдельный от школьного бота
BOT_TOKEN=

# Сколько работ должно набраться в теме, чтобы бот закрыл её автоматически
TOPIC_WORK_THRESHOLD=20

# Адрес мини-приложения (https). Пусто — бот работает без него
WEBAPP_URL=

# Группы, где работает счётчик тем (id через запятую, например -1001234567890). Пусто: во всех
ALLOWED_CHAT_IDS=

# Режим вебхука для «засыпающих» хостингов (Render и т.п.). Пусто: polling
# На Render эти значения выставляются автоматически (RENDER_EXTERNAL_URL, WEBHOOK_SECRET)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Редактор для учителя (команда /teacher в боте). Включается, если заданы все четыре:
# id аккаунтов Telegram учителей через запятую (свой id покажет команда /myid)
TEACHER_IDS=
# токен GitHub с правом Contents: Read and write только на этот репозиторий
GITHUB_TOKEN=
GITHUB_REPO=kopervas0/chinese-drill-bot
GITHUB_BRANCH=master
