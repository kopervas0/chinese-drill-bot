{
  "name": "chinese-drill-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bot.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bot.js",
    "webapp:build": "node scripts/build-webapp.mjs",
    "webapp:dev": "node scripts/dev-webapp.mjs",
    "webapp:deploy": "node scripts/deploy-webapp.mjs",
    "decks:check": "node scripts/check-decks.mjs",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.0",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
